{
  "name": "atkuzu",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:logging": "vite dev | pino-pretty",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite start",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint . --fix && eslint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format-lint": "oxfmt --write . && oxlint . --fix && eslint . --fix",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lexicons:validate": "tsx scripts/validate-lexicons.ts",
    "lexicons:publish": "tsx scripts/publish-lexicons.ts",
    "records:delete": "tsx scripts/delete-record.ts",
    "daily:generate": "tsx scripts/generate-daily.ts",
    "daily:schedule": "tsx scripts/schedule-daily.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.18.6",
    "@atproto/common": "^0.5.3",
    "@atproto/crypto": "^0.4.5",
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/oauth-client-node": "^0.3.13",
    "@atproto/oauth-types": "^0.5.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@sveltejs/adapter-node": "^5.4.0",
    "better-sqlite3": "12.4.1",
    "node-schedule": "^2.1.1",
    "pino": "^10.1.0",
    "svelte-french-toast": "2.0.0-alpha.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.1",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/node-schedule": "^2.1.8",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "sass": "^1.103.1",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-musl": "^4.52.5"
  }
}
